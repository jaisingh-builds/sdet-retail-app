{
  "name": "shopkart-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node src/migrate.js",
    "db:probe": "node src/database-probe.js",
    "db:reset": "node src/migrate.js --reset",
    "test": "node --test test/unit/*.test.js",
    "test:container": "node --test --test-timeout=120000 test/integration/*.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "mysql2": "^3.22.5",
    "pg": "^8.22.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@testcontainers/mysql": "^12.0.4",
    "@testcontainers/postgresql": "^12.0.4"
  },
  "engines": {
    "node": ">=20"
  }
}
