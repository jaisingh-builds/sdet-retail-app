{
  "name": "shopkart-capstone-sut",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm ci --prefix backend && npm ci --prefix frontend",
    "build": "npm run build --prefix frontend",
    "start": "npm run build && npm start --prefix backend",
    "dev:api": "npm run dev --prefix backend",
    "dev:web": "npm run dev --prefix frontend",
    "db:migrate": "npm run db:migrate --prefix backend",
    "db:probe": "npm run db:probe --prefix backend",
    "db:reset": "npm run db:reset --prefix backend",
    "smoke": "node scripts/shopkart-smoke.mjs",
    "test": "npm test --prefix backend && npm run build --prefix frontend",
    "test:ci": "npm run test:container --prefix backend"
  },
  "engines": {
    "node": ">=20"
  }
}
